NEXT_PUBLIC_SITE_URL=https://seahawkgroup.co.in
# Set to 1 on staging so it is noindex + robots disallow
NEXT_PUBLIC_NOINDEX=0
# Optional consent-aware GA4 (loads only after "Accept all")
NEXT_PUBLIC_GA_ID=
# Optional webhook to your CRM / secure inbox for enquiries
LEAD_WEBHOOK_URL=
# Where submissions + uploads are stored (NOT under /public). Use an encrypted, backed-up volume.
DATA_DIR=./.data
# Staff login: >=32 random chars
SESSION_SECRET=
# Staff users. Generate hash: node scripts/hash-password.mjs "password"
# ADMIN_USERS='[{"user":"admin","role":"admin","hash":"scrypt:..."},{"user":"recruiter","role":"recruiter","hash":"scrypt:..."}]'
ADMIN_USERS=[]
